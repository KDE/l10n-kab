#: rc.cpp:15
msgid ""
"<qt>Search entries by entering"
"<br> - one of their <b>email addresses</b>"
"<br> - the <b>first name</b> or<br> - the <b>last name</b></qt>"
msgstr ""
"<qt>Pesquisar os registos indicando"
"<br> - um dos seus <b>endereços de e-mail</b>"
"<br> - o <b>primeiro nome</b> ou <br> - o <b>último nome</b></qt>"

