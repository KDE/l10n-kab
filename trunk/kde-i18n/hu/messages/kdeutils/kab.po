#: kab_main.cc:29 kab_main.cc:36
msgid "KDE Addressbook"
msgstr "KDE címjegyzék"

#: kab_main.cc:47
msgid ""
"<qt>Version 2 of the KDE address book is not compatible with the previous "
"one. To protect your address database, a new file will be used. Run "
"<b>File->Import->KDE 1 addressbook</b> to use your old database with the new "
"version.</qt>"
msgstr ""
"<qt>A 2. verziójú KDE címjegyzék nem kompatibilis az előző verzióval. "
"A címjegyzék adatbázisának megőrzése érdekében egy másik fájlt "
"használok. A régi adatbázist a <b>Fájl->Importálás->KDE 1 "
"címjegyzék</b> parancs kiadásával lehet elérni.</qt>"

#: kab_main.cc:52
