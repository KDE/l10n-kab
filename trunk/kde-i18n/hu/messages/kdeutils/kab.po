#: rc.cpp:15
msgid ""
"<qt>Search entries by entering"
"<br> - one of their <b>email addresses</b>"
"<br> - the <b>first name</b> or<br> - the <b>last name</b></qt>"
msgstr ""
"<qt>Keresés a bejegyzések között"
"<br> - az <b>e-mail cím</b>"
"<br> - a <b>keresztnév</b> vagy a<br> - <b>vezetéknév</b> alapján</qt>"

