msgid "Case sensitive search"
msgstr "Nagybetűérzékeny keresés"

#: rc.cpp:41
msgid "Check this box if you want to do a case-sensitive search."
msgstr "Jelölje be ezt az opciót, ha nagybetűérzékeny keresést szeretne."

#: rc.cpp:42
msgid "Expressions"
