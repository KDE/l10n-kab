#: rc.cpp:30
msgid "Select fields to search here."
msgstr "Veldu svið til að leita í."

#: rc.cpp:31
msgid ""
"Select fields to search here. \n"
"All entries where this field matches the pattern (consisting of wildcards or "
"regular expressions) given below will be displayed in the Search Results "
"Window."
msgstr ""
"Veldu svið hér til að leita í. \n"
"Allar færslur þar sem þetta svið samsamar mynstrinu (sem samanstenduraf "
"algildistáknum eða reglulegum segðum) sem gefin eru hér fyrir neðanverða "
"sýndar í niðurstöðuglugganum."

#: rc.cpp:32
msgid "... matches ..."
msgstr "... samsamast við ..."

