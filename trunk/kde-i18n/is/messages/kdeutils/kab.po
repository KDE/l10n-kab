#: kab_main.cc:29 kab_main.cc:36
msgid "KDE Addressbook"
msgstr "KDE símaskrá"

#: kab_main.cc:47
msgid ""
"<qt>Version 2 of the KDE address book is not compatible with the previous "
"one. To protect your address database, a new file will be used. Run "
"<b>File->Import->KDE 1 addressbook</b> to use your old database with the new "
"version.</qt>"
msgstr ""
"<qt>Útgáfa 2 af KDE símaskránni er ekki samhæfð fyrri útgáfum. Til að vernda "
"upplýsingarnar þínar verður notuð ný skrá en þú getur notað <b>Skrá->Flytja "
"inn->KDE 1 símaskrá</b> til að færa gögnin inn í þessa útgáfu."

#: kab_main.cc:52
msgid "new format"
msgstr "nýtt form"

