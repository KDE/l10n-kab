#: kab_main.cc:29 kab_main.cc:36
msgid "KDE Addressbook"
msgstr "KDE aadressiraamat"

#: kab_main.cc:47
msgid ""
"<qt>Version 2 of the KDE address book is not compatible with the previous "
"one. To protect your address database, a new file will be used. Run "
"<b>File->Import->KDE 1 addressbook</b> to use your old database with the new "
"version.</qt>"
msgstr ""
"<qt>KDE aadressiraamatu versioon 2 pole varasemaga kompatiibel. Et kaitsta "
"sinu aadressite andmebaasi, kasutatakse uut faili. Kui soovid kasutada vana "
"andmebaasi uue versiooniga käivita <b>Fail->Impordi->KDE1 "
"aadressiraamat.</b></qt>"

#: kab_main.cc:52
msgid "new format"
msgstr "uus vorming"

