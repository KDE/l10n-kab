#: kab_main.cc:29 kab_main.cc:36
msgid "KDE Addressbook"
msgstr "Kniha adres KDE"

#: kab_main.cc:47
msgid ""
"<qt>Version 2 of the KDE address book is not compatible with the previous "
"one. To protect your address database, a new file will be used. Run "
"<b>File->Import->KDE 1 addressbook</b> to use your old database with the new "
"version.</qt>"
msgstr ""
"<qt>Verze 2 KDE adresáře není kompatibilní s předchozí verzí.\n"
"Pro ochranu vaší databáze bude použit jiný soubor.\n"
"Spusťte \"Soubor->Importovat->Adresář KDE 1\", chcete-li\n"
"použít svou starou databázi v nové verzi.</qt>"

#: kab_main.cc:52
msgid "new format"
msgstr "nový formát"

