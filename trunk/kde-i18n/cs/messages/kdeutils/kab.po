msgstr ""
"<qt>Některý ze <b>zdrojových souborů</b> použitých pro export "
"adresáře do HTML chybí. Přesto pokračovat?"
"<br>"
"<br><i>(Zdrojové soubory jsou použity pro podporu výsledných HTML "
"souborů jako jsou pozadí nebo odrážky.)</i></qt>"

#: kab_htmlexport.cc:449
msgid ""
"<qt>At least one <b>template file</b> used to export your address book to "
"HTML is missing. Continue anyway?"
"<br>"
"<br><i>(Templates are used as a basis to create the HTML files themselves. "
"The HTML export will most probably not work without it.)</i></qt>"
msgstr ""
"<qt>Některý ze <b>souborů šablon</b> použitý pro export adresáře do "
"HTML chybí. Přesto pokračovat?"
"<br>"
"<br><i>(Šablony jsou použity jako základní soubory při vytváření "
"HTML souborů. Export do HTML nebude bez nich fungovat).</i></qt>"

#: kab_htmlexport.cc:489
msgid "Missing Resource"
msgstr "Chybějící zdroj"

