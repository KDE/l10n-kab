#: rc.cpp:15
msgid ""
"<qt>Search entries by entering"
"<br> - one of their <b>email addresses</b>"
"<br> - the <b>first name</b> or<br> - the <b>last name</b></qt>"
msgstr ""
"<qt>ค้นหารายการ โดยการเติม"
"<br>"
" - สิ่งใดสิ่งหนึ่งเหล่านี้ "
"<b>ที่อยู่อีเมล์</b>"
"<br> - <b>ชื่อ</b> หรือ"
"<br> - <b>นามสกุล</b></qt>"

#: rc.cpp:17
msgid "<qt>Select an entry to display it.</qt>"
msgstr ""
"<qt>เลือกรายการที่ต้องการให้"
"แสดง</qt>"

