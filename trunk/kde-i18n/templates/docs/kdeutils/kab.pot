	"<keycombo><keycap>Ctrl</keycap><keycap>E</keycap></keycombo> "
	"</shortcut> <guimenu><accel>F</accel>ile</guimenu> "
	"<guisubmenu><accel>P</accel>rint</guisubmenu> <guimenuitem>Print "
