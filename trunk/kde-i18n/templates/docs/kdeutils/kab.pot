	"<guimenuitem><accel>I</accel>mport</guimenuitem>"
msgstr	""

#: index.docbook:184
msgid	"Lets you <action>import an address book</action> generated by "
	"version 1 of &kab;, changing its format to that used by version 2, "
	"and saving it with a different name. Doing this does not destroy the "
	"original version 1 address book."
msgstr	""

#: index.docbook:184
msgid	"<shortcut> "
	"<keycombo><keycap>Ctrl</keycap><keycap>T</keycap></keycombo> "
	"</shortcut> <guimenu><accel>F</accel>ile</guimenu> "
	"<guisubmenu><accel>P</accel>rint</guisubmenu> <guimenuitem>Print "
	"entry</guimenuitem>"
msgstr	""

#: index.docbook:184
msgid	"To print out all details of the current entry."
