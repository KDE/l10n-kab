msgid	"<action>Lets you configure some parameters of the current address "
	"book</action>. At present the <guilabel>User fields</guilabel> tab "
	"page does not function, but the <guilabel>Address types</guilabel> "
	"tab page can be used to set up default address <guilabel>Address "
	"type</guilabel> values."
msgstr	""

#: index.docbook:334
msgid	"<guimenu><accel>E</accel>dit</guimenu> "
