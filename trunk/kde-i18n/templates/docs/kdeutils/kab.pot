msgid	"<shortcut> "
	"<keycombo><keycap>Ctrl</keycap><keycap>S</keycap></keycombo> "
	"</shortcut> <guimenu><accel>F</accel>ile</guimenu> "
	"<guimenuitem><accel>S</accel>ave</guimenuitem>"
msgstr	""

#: index.docbook:184
msgid	"<action>Save</action> the current &kab; database."
