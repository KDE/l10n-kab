#: index.docbook:221
msgid	"<guimenu><accel>F</accel>ile</guimenu> "
	"<guisubmenu><accel>I</accel>mport</guisubmenu> "
	"<guimenuitem><accel>N</accel>etscape address book</guimenuitem>"
