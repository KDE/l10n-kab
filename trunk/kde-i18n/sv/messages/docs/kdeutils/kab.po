msgid ""
"<guimenu><accel>F</accel>ile</guimenu> <guisubmenu><accel>I</"
"accel>mport</guisubmenu> <guimenuitem><accel>K</accel>DE 1 address "
"book</guimenuitem>"
msgstr ""
"<guimenu><accel>A</accel>rkiv</guimenu> <guisubmenu><accel>I</"
"accel>mportera</guisubmenu> <guimenuitem><accel>K</accel>DE 1 "
"adressbok</guimenuitem>"

#: index.docbook:231
msgid ""
"Lets you <action>import an address book</action> generated by "
"version 1 of &kab;, changing its format to that used by version 2, "
"and saving it with a different name. Doing this does not destroy the "
"original address book."
msgstr ""
"Låter dig <action>importera en adressbok</action> som skapats av "
"version 1 av &kab;, och ändra formatet till det som används av version 2, "
"och spara den med ett annat namn. Att göra det här förstör inte "
"adressbokens original."

#: index.docbook:231
msgid ""
"<guimenu><accel>F</accel>ile</guimenu> <guisubmenu><accel>I</"
"accel>mport</guisubmenu> <guimenuitem><accel>N</accel>etscape "
"address book</guimenuitem>"
msgstr ""
"<guimenu><accel>A</accel>rkiv</guimenu> <guisubmenu><accel>I</"
"accel>mportera</guisubmenu> <guimenuitem><accel>N</accel>etscape "
"adressbok</guimenuitem>"

#: index.docbook:231
msgid ""
"Lets you <action>import an address book</action> generated by "
"&Netscape;."
msgstr ""
"Låter dig <action>importera en adressbok</action> som skapats av "
"&Netscape;."

#: index.docbook:231
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>T</keycap></"
"keycombo> </shortcut> <guimenu><accel>F</accel>ile</guimenu> "
"<guisubmenu><accel>P</accel>rint</guisubmenu> <guimenuitem>Print "
"entry</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>T</keycap></"
"keycombo> </shortcut> <guimenu><accel>A</accel>rkiv</guimenu> "
"<guisubmenu><accel>S</accel>kriv ut</guisubmenu> <guimenuitem>Skriv "
"ut post</guimenuitem>"

#: index.docbook:231
msgid "To print out all details of the current entry."
msgstr "Skriver ut alla detaljer om den nuvarande posten."

#: index.docbook:231
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>E</keycap></"
"keycombo> </shortcut> <guimenu><accel>F</accel>ile</guimenu> "
"<guisubmenu><accel>P</accel>rint</guisubmenu> <guimenuitem>Print "
"entries</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>E</keycap></"
"keycombo> </shortcut> <guimenu><accel>A</accel>rkiv</guimenu> "
"<guisubmenu><accel>S</accel>kriv ut</guisubmenu> <guimenuitem>Skriv "
"ut poster</guimenuitem>"

