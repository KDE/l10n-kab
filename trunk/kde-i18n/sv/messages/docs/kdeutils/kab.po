msgid ""
"<shortcut><keycap>F1</keycap> </shortcut> <guimenu><accel>H</"
"accel>elp</guimenu> <guimenuitem><accel>C</accel>ontents</"
"guimenuitem>"
msgstr ""
"<shortcut> <keycombo><keycap>F1</keycap></keycombo> </shortcut> "
"<guimenu><accel>H</accel>jälp</guimenu><guimenuitem><accel>I</accel>"
"nnehåll</guimenuitem>"

#: index.docbook:553
msgid "<action>View this manual</action>."
msgstr "<action>Visar den här handboken</action>."

#: index.docbook:553
msgid ""
"<guimenu><accel>H</accel>elp</guimenu> <guimenuitem><accel>R</"
"accel>eport Bug...</guimenuitem>"
msgstr ""
"<guimenu><accel>H</accel>jälp</guimenu> "
"<guimenuitem><accel>R</accel>apportera fel</guimenuitem>"

#: index.docbook:553
msgid "Use this to <action>report any bugs you may find with &kab;</action>."
msgstr ""
"Använd det här för att <action>rapportera eventuella fel som du hittar i "
"&kab;</action>."

#: index.docbook:553
msgid ""
"<guimenu><accel>H</accel>elp</guimenu> <guimenuitem><accel>A</"
"accel>bout &kghostview;</guimenuitem>"
msgstr ""
"<guimenu><accel>H</accel>jälp</guimenu> <guimenuitem><accel>O</accel>m "
"KDE-adressbok</guimenuitem>"

#: index.docbook:553
msgid ""
"Use this to <action>see the version number of &kab; as well as brief "
"information about the program author, copyright and license "
"agreement</action>."
msgstr ""
"Använd det här för att <action>se versionsnumret för &kab; samt kortfattad "
"information om programmets upphovsman, copyright och licensöverenskommelse"
"</action>."

#: index.docbook:553
msgid ""
"<guimenu><accel>H</accel>elp</guimenu> <guimenuitem>About <accel>K</"
"accel>DE</guimenuitem>"
msgstr ""
"<guimenu><accel>H</accel>jälp</guimenu> <guimenuitem>Om "
"<accel>K</accel>DE</guimenuitem>"

#: index.docbook:553
msgid ""
"To view <action>brief information about the K Desktop Environment</"
"action>."
msgstr "För att visa <action>kortfattad information om K-skrivbordsmiljö</action>."

#: index.docbook:609
msgid "Questions and Answers"
msgstr "Frågor och svar"

#: index.docbook:615
msgid "Where does &kab; store the address book?"
msgstr "Var lagrar &kab; adressboken?"

#: index.docbook:618
msgid ""
"The default address book database is stored at <filename>~/.kde/"
"share/apps/kab/addressbook.kab</filename>, any new databases that "
"you have created will be stored wherever you put them."
msgstr ""
"Den förvalda adressboksdatabasen lagras på <filename>~/.kde/"
"share/apps/kab/addressbook.kab</filename>, eventuella nya databaser "
"som du skapat lagras var du än lägger dem."

#: index.docbook:627
msgid "What configuration files does &kab; use?"
msgstr "Vilka konfigurationsfiler använder &kab;?"

#: index.docbook:630
msgid ""
"The file <filename>~/.kde/share/apps/kab/kab.config</filename> holds "
"your &kab; <quote>preferences</quote> and the command strings for "
"mail and talk."
msgstr ""
"Filen <filename>~/.kde/share/apps/kab/kab.config</filename> innehåller "
"&kab;s <quote>inställningar</quote> och kommandosträngarna för "
"e-post och talk."

#: index.docbook:634
msgid ""
"<filename>~/.kde/share/config/kabrc</filename> holds general &kab; "
"appearance parameters and a list of the most recently visited "
"address books."
msgstr ""
"<filename>~/.kde/share/config/kabrc</filename> innehåller allmäna "
"värden för &kab;s utseende och en lista på de senast öppnade "
"adressböckerna."

#: index.docbook:638
msgid ""
"Don't modify these files unless you really know what you are doing "
"(and have made a back up)."
msgstr ""
"Ändra inte de här filerna om du inte verkligen vet vad du gör "
"(och har gjort en säkerhetskopia)."

