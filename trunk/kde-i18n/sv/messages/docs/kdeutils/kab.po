"keycombo> </shortcut> <guimenu><accel>A</accel>rkiv</guimenu> "
"<guimenuitem>Ö<accel>p</accel>pna...</guimenuitem>"

#: index.docbook:231
msgid ""
"<action>Open</action> a &kab; database. This menu choice is used to "
"open a new address book that you have created."
msgstr ""
"<action>Öppnar</action> en &kab;-databas. Det här menyalternativet används "
"för att öppna en ny adressbok som du har skapat."

#: index.docbook:231
msgid ""
"<guimenu><accel>F</accel>ile</guimenu> <guimenuitem>Open default "
"<accel>d</accel>atabase</guimenuitem>"
msgstr ""
"<guimenu><accel>A</accel>rkiv</guimenu> <guimenuitem>Öppna "
"standard<accel>d</accel>atabas</guimenuitem>"

#: index.docbook:231
msgid "<action>Opens the default</action> &kab; database."
msgstr "<action>Öppnar den förvalda</action> &kab;-databasen."

#: index.docbook:231
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></"
"keycombo> </shortcut> <guimenu><accel>F</accel>ile</guimenu> "
"<guimenuitem><accel>S</accel>ave</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></"
"keycombo> </shortcut> <guimenu><accel>A</accel>rkiv</guimenu> "
"<guimenuitem><accel>S</accel>para</guimenuitem>"

#: index.docbook:231
msgid "<action>Save</action> the current &kab; database."
msgstr "<action>Sparar</action> edn nuvarande &kab;-databasen."

