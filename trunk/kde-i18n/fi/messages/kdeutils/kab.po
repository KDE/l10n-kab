#: kab_main.cc:29 kab_main.cc:36
msgid "KDE Addressbook"
msgstr "KDE osoitekirja"

#: kab_main.cc:47
msgid ""
"<qt>Version 2 of the KDE address book is not compatible with the previous "
"one. To protect your address database, a new file will be used. Run "
"<b>File->Import->KDE 1 addressbook</b> to use your old database with the new "
"version.</qt>"
msgstr ""
"<qt>Versio 2 KDE:n osoitekirjasta ei ole yhteensopiva edellisen kanssa. "
"Osoitekirjasi suojelemiseksi käytetään uutta tiedostoa. Aja "
"<b>Tiedosto->Tuo->KDE 1 osoitekirja</b> käyttääksesi vanhaa tietokantaa "
"uudella versiolla.</qt>"

#: kab_main.cc:52
msgid "new format"
msgstr "uusi muoto"

