#: rc.cpp:1
msgid "Export to HTML"
msgstr "ייצוא בתור HTML"

#: rc.cpp:2
msgid "Exporting of addresses"
msgstr "ייצוא כתובות"

#: rc.cpp:3
msgid "Export addresses along with entries"
msgstr "ייצא כתובות ביחד עם הרשומות"

#: rc.cpp:4
msgid "How should I export your addresses?"
msgstr "כיצד לייצא את הכתובות שלך?"

#: rc.cpp:5
msgid "Address and person in one line"
msgstr "הכתובות והאדם באותה השורה"

#: rc.cpp:6
msgid "All addresses"
msgstr "כל הכתובות"

#: rc.cpp:7
msgid "Up to ... addresses"
msgstr "עד ... כתובות"

#: rc.cpp:8
msgid "Select style of HTML "
msgstr "בחר את סגנון ה-HTML "

#: rc.cpp:9
msgid "Style of the resulting file"
msgstr "סגנון הקובץ הסופי"

#: rc.cpp:10
msgid "Plain HTML text without tables or lines"
msgstr "תבנית HTML פשוטה ללא טבלאות או שורות"

#: rc.cpp:11
msgid "Expect more here..."
msgstr "צפה לעוד..."

#: rc.cpp:12 rc.cpp:23 rc.cpp:32 rc.cpp:47
msgid "Form1"
msgstr "טופס1"

#: rc.cpp:13
msgid "Enter the delivery label for this address here:"
msgstr "הזן כאן את תווית המסירה של כתובת זו:"

#: rc.cpp:14
msgid "Entry List"
msgstr "רשימת רשומות"

#: rc.cpp:15
msgid ""
"<qt>Search entries by entering"
"<br> - one of their <b>email addresses</b>"
"<br> - the <b>first name</b> or<br> - the <b>last name</b></qt>"
msgstr ""
"<qt>חפש רשומות על ידי הזנה של"
"<br> - אחת מ<b>כתובות הדוא\"ל</b> שלהן"
"<br> - <b>השם הפרטי</b> או<br> - <b>שם המשפחה</b></qt>"

#: rc.cpp:17
msgid "<qt>Select an entry to display it.</qt>"
msgstr "<qt>בחר רשומה כדי להציגה.</qt>"

#: kab_htmlexport.cc:377 rc.cpp:18
msgid "Setup HTML export"
msgstr "הגדרות ייצוא בתור HTML"

#: rc.cpp:19
msgid "Template folder:"
msgstr "תיקיית תבניות:"

#: rc.cpp:20
msgid "Target folder:"
msgstr "תיקיית יעד:"

#: rc.cpp:21 rc.cpp:22
msgid "Choose ..."
msgstr "בחירה..."

#: rc.cpp:26
msgid "Hide the search results window. This will not clear your search results."
msgstr ""
"הסתרת חלון תוצאות החיפוש. דבר זה לא ינקה "
"את תוצאות החיפוש שלך."

#: rc.cpp:27
msgid ""
"Hide the search results window. This will close the search results window "
"and clear all results of previous searches."
msgstr ""
"הסתרת חלון תוצאות החיפוש. דבר זה יסגור את "
"חלון תוצאות החיפוש וינקה את כל תוצאות "
"החיפושים הקודמים."

#: rc.cpp:29
msgid "Clear the search results and hide this window."
msgstr "ניקוי תוצאות החיפוש והסתרת חלון זה."

#: rc.cpp:31
msgid "Print your search results."
msgstr "הדפס את תוצאות החיפוש שלך."

#: rc.cpp:33
msgid "Search for people in your addressbook:"
msgstr "חפש אנשים בפנקס הכתובות שלך:"

#: rc.cpp:34
msgid "Select fields to search here."
msgstr "בחר כאן סעיפים לחיפוש."

#: rc.cpp:35
msgid ""
"Select fields to search here. \n"
"All entries where this field matches the pattern (consisting of wildcards or "
"regular expressions) given below will be displayed in the Search Results "
"Window."
msgstr ""
"בחר כאן סעיפים לחיפוש. \n"
"כל הרשומות בהם סעיף זה תואם לדפוס (שיכול "
"להכיל תווים כלליים או ביטויים סדירים) "
"הנתון יוצגו בחלון תוצאות החיפוש."

#: rc.cpp:36
msgid "... matches ..."
msgstr "... תואם ..."

#: rc.cpp:37
msgid "*"
msgstr "*"

#: rc.cpp:38
msgid "Enter your expression here."
msgstr "הזן כאן את הביטוי שלך."

#: rc.cpp:39
msgid "Options:"
msgstr "אפשרויות:"

#: rc.cpp:40
msgid "Case sensitive search"
msgstr "חיפוש תלוי רישיות"

#: rc.cpp:41
msgid "Check this box if you want to do a case-sensitive search."
msgstr ""
"בחר בתיבה זו אם ברצונך לבצע חיפוש תלוי "
"רישיות."

#: rc.cpp:42
msgid "Expressions"
msgstr "ביטויים"

#: rc.cpp:43
msgid "Wildcards"
msgstr "תווים כלליים"

#: rc.cpp:44
msgid ""
"Check this button if you use widlcards in your expression (as in shell "
"commands)."
msgstr ""
"בחר באפשרות זו אם ברצונך להשתמש בתויים "
"כלליים בביטוי שלך (כמו בפקודות מעטפת)."

#: rc.cpp:45
msgid "Regular expressions"
msgstr "ביטויים סדירים"

#: rc.cpp:46
msgid "Check this box if you use classical regular expressions in your pattern."
msgstr ""
"בחר בתיבה זו אם אתה משתמש בתבנית שלך "
"בביטויים סדירים קלאסיים."

#: rc.cpp:48
msgid "Address type (e.g. Home):"
msgstr "סוג הכתובת (לדוגמה בית):"

#: rc.cpp:49
msgid "Organization..."
msgstr "אירגון..."

#: rc.cpp:50
msgid "Country:"
msgstr "ארץ:"

#: rc.cpp:51
msgid "Zip code"
msgstr "מיקוד"

#: rc.cpp:52
msgid "State"
msgstr "מדינה"

#: rc.cpp:53
msgid "City"
msgstr "יישוב"

#: rc.cpp:54
msgid "Street address:"
msgstr "כתובת:"

#: rc.cpp:55
msgid "Job title:"
msgstr "תפקיד:"

#: look_edit_tabaddresses.cc:328 rc.cpp:56
msgid "Delivery Label"
msgstr "תווית מסירה"

#: kab_main.cc:29 kab_main.cc:36
msgid "KDE Addressbook"
msgstr "פנקס הכתובות של KDE"

#: kab_main.cc:49
msgid ""
"<qt>Version 2 of the KDE address book is not compatible with the previous "
"one. To protect your address database, a new file will be used. Run "
"<b>File->Import->KDE 1 Addressbook</b>"
" to use your old database with the new version.</qt>"
msgstr ""
"<qt>גירסה 2 של פנקס הכתובות של KDE אינה תואמת "
"לגירסה הקודמת. כדי להגן על מסד הנתוני "
"הכתובות שלך, ייעשה שימוש בקובץ חדש. בחר "
"ב<b>קובץ->ייבא->פנקס כתובות של KDE 1</b> כדי "
"להשתמש במסד הנתונים הישן שלך עם הגירסה "
"החדשה.</qt>"

#: kab_main.cc:54
msgid "New Format"
msgstr "גירסה חדשה"

