#: kab_main.cc:29 kab_main.cc:36
msgid "KDE Addressbook"
msgstr "KDE לש תובותכה רפס"

#: kab_main.cc:47
msgid ""
"<qt>Version 2 of the KDE address book is not compatible with the previous "
"one. To protect your address database, a new file will be used. Run "
"<b>File->Import->KDE 1 addressbook</b> to use your old database with the new "
"version.</qt>"
msgstr ""
"<qt><p align=right>תמאות הניא KDE לש תובותכה רפס לש 2 "
"הסריג<br>רפס לש םינותנה סיסב לע ןגהל ידכ "
".תמדוקה הסריגל<br>רחב .שדח ץבוקב שומיש "
"השעיי ,ךלש תובותכה <br><b>KDE 1 לש תובותכ "
"רפס&lt;-אביי&lt;-ץבוק</b>ב<br>םע ךלש ןשיה "
"םינותנה סיסבב שמתשהל ידכ<br>.השדחה "
"הסריגה</qt>"

#: kab_main.cc:52
msgid "new format"
msgstr "השדח הסריג"

