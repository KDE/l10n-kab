#: kab_main.cc:51
msgid ""
"<qt>Version 2 of the KDE address book is not compatible with the previous one"
". To protect your address database, a new file will be used. Run <b>File->Imp"
"ort->KDE 1 addressbook</b> to use your old database with the new version.</qt"
">"
msgstr ""
"<qt>La versione 2 della rubrica di KDE non è compatibile con la versione pre"
"cedente. Per proteggere la tua rubrica, verrà usato un nuovo file. Esegui <b"
">File->Importa->Rubrica di KDE 1</b> per usare la tua vecchia rubrica con la "
"nuova versione.</qt>"

#: kab_main.cc:56
msgid "new format"
msgstr "nuovo formato"

