msgid "Case sensitive search"
msgstr "Maiuscole/minuscole"

#: rc.cpp:41
msgid "Check this box if you want to do a case-sensitive search."
msgstr ""
"Marca questa casella se vuoi che la ricerca faccia differenza tra maiuscole "
"e minuscole."

#: rc.cpp:42
msgid "Expressions"
msgstr "Espressioni"

#: rc.cpp:43
msgid "Wildcards"
msgstr "Caratteri jolly"

#: rc.cpp:44
msgid ""
"Check this button if you use widlcards in your expression (as in shell "
"commands)."
msgstr ""
"Marca questa casella se utilizzi i caratteri jolly nell'espressione (come "
"nei comandi della shell)"

#: rc.cpp:45
msgid "Regular expressions"
msgstr "Espressioni regolari"

#: rc.cpp:46
msgid "Check this box if you use classical regular expressions in your pattern."
