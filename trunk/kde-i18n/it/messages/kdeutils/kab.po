msgid "KDE Addressbook"
msgstr "Rubrica degli indirizzi di KDE"

#: kab_main.cc:49
msgid ""
"<qt>Version 2 of the KDE address book is not compatible with the previous "
"one. To protect your address database, a new file will be used. Run "
"<b>File->Import->KDE 1 Addressbook</b>"
" to use your old database with the new version.</qt>"
msgstr ""
"<qt>La versione 2 della rubrica di KDE non è compatibile con la versione "
"precedente. Per proteggere la tua rubrica, verrà usato un nuovo file. "
"Esegui <b>File->Importa->Rubrica di KDE 1</b> per usare la tua vecchia "
"rubrica con la nuova versione.</qt>"

