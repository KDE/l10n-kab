#: rc.cpp:15
msgid ""
"<qt>Search entries by entering"
"<br> - one of their <b>email addresses</b>"
"<br> - the <b>first name</b> or<br> - the <b>last name</b></qt>"
msgstr ""
"<qt>Cerca le voci immettendo"
"<br> - uno degli <b>indirizzi di posta elettronica</b>"
"<br> - il <b>nome</b> o<br> - il <b>cognome</b></qt>"

