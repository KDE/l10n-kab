"<keycombo><keycap>Ctrl</keycap><keycap>M</keycap></keycombo> "
"</shortcut> <guimenu><accel>E</accel>dit</guimenu> <guimenuitem>Send "
"an <accel>e</accel>mail.</guimenuitem>"
msgstr ""
