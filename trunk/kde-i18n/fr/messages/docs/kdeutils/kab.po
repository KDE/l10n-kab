"</shortcut>"
"<guimenu><accel>F</accel>ichier</guimenu>"
"<guisubmenu><accel>I</accel>mprimer</guisubmenu>"
"<guimenuitem>Imprimer les entrées</guimenuitem>"

#: index.docbook:185
msgid "To print out all details of all entries in the database."
msgstr "Pour imprimer l'ensemble des détails de l'ensemble des entrées dans la base de donnée."

#: index.docbook:185
msgid ""
