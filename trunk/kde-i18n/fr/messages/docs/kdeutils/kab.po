"<keycombo><keycap>Ctrl</keycap><keycap>A</keycap></keycombo> "
"</shortcut> <guimenu><accel>E</accel>dit</guimenu> "
"<guimenuitem><accel>A</accel>dd entry...</guimenuitem>"
