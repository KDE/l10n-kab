"<keycombo><keycap>Ctrl</keycap><keycap>R</keycap></keycombo> "
"</shortcut> <guimenu><accel>E</accel>dit</guimenu> "
"<guimenuitem><accel>R</accel>emove entry</guimenuitem>"
msgstr ""
"<shortcut>"
"<keycombo><keycap>Ctrl</keycap><keycap>R</keycap></keycombo>"
"</shortcut>"
"<guimenu><accel>E</accel>dition</guimenu>"
"<guimenuitem>Supprimer l'entrée</guimenuitem>"

#: index.docbook:292
msgid "Remove the current entry from the database."
msgstr "Supprime l'entrée actuelle de la base de donnée."

#: index.docbook:292
msgid ""
