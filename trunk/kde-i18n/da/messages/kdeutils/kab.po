#: kab_main.cc:29 kab_main.cc:36
msgid "KDE Addressbook"
msgstr "KDE adressebog."

#: kab_main.cc:47
msgid ""
"<qt>Version 2 of the KDE address book is not compatible with the previous "
"one. To protect your address database, a new file will be used. Run "
"<b>File->Import->KDE 1 addressbook</b> to use your old database with the new "
"version.</qt>"
msgstr ""
"<qt>Version 2 af kde's adressebog er ikke kompatibel med den tidligere "
"udgave.For at beskytte din database med adresse, vil en anden fil blive "
"brugt. Kør <b>Fil->Importér->KDE 1 adressebog</b> for at bruge din gamle "
"database med en nye version."

