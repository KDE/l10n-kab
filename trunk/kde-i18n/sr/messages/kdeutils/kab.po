msgid "Select fields to search here."
msgstr "Izaberite ovde polja koja želite da pretražite."

#: rc.cpp:35
msgid ""
"Select fields to search here. \n"
"All entries where this field matches the pattern (consisting of wildcards or "
"regular expressions) given below will be displayed in the Search Results "
"Window."
msgstr ""
"Izaberite ovde polja koja želite da pretražite. \n"
"Sve stavke u kojima se ovo polje podudara sa obrascem (sastoji se iz "
"džokera iliregularnih izraza) datih gore, će biti prikazani u zasebnom "
"prozoru."

#: rc.cpp:36
msgid "... matches ..."
msgstr "... se podudara sa ..."

#: rc.cpp:37
msgid "*"
msgstr "*"

