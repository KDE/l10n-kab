#: rc.cpp:41
msgid "Check this box if you want to do a case-sensitive search."
msgstr ""
"Označite ovu opciju ako želite da uradite pretragu gde se ne razlikuju "
"mala i velika slova."

#: rc.cpp:42
msgid "Expressions"
msgstr "Izrazi"

#: rc.cpp:43
msgid "Wildcards"
msgstr "Džokeri"

#: rc.cpp:44
msgid ""
"Check this button if you use widlcards in your expression (as in shell "
"commands)."
msgstr ""
"Čekirajte ovu opciju ako korisitite džokere u vašem izrazu (kao u shell "
"komandama)."

#: rc.cpp:45
msgid "Regular expressions"
msgstr "Regularni izrazi"

#: rc.cpp:46
msgid "Check this box if you use classical regular expressions in your pattern."
msgstr ""
"Čekirajte ovu opciju ako koristite klasične regularne izraze u vašem "
"obrascu."

