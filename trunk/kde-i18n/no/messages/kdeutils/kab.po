#: kab_main.cc:29 kab_main.cc:36
msgid "KDE Addressbook"
msgstr "KDE Adressebok"

#: kab_main.cc:47
msgid ""
"<qt>Version 2 of the KDE address book is not compatible with the previous "
"one. To protect your address database, a new file will be used. Run "
"<b>File->Import->KDE 1 addressbook</b> to use your old database with the new "
"version.</qt>"
msgstr ""
"<qt>Versjon 2 av KDE adressebok er ikke kompatibel med forrige versjon. For "
"å besykkte databasen din vil en annen fil bli brukt. Velg "
"<b>Fil->Import->KDE 1 adressebok</b> for å bruke din gamle database med den "
"nye versjonen.</qt>"

#: kab_main.cc:52
msgid "new format"
msgstr "nytt format"

