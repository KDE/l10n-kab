#: kab_main.cc:29 kab_main.cc:36
msgid "KDE Addressbook"
msgstr "Libro de direcciones KDE"

#: kab_main.cc:47
msgid ""
"<qt>Version 2 of the KDE address book is not compatible with the previous "
"one. To protect your address database, a new file will be used. Run "
"<b>File->Import->KDE 1 addressbook</b> to use your old database with the new "
"version.</qt>"
msgstr ""
"<qt>La Versión 2 del Libro de direcciones KDE no es compatible con las "
"anteriores. Para proteger su base de datos de direcciones, se usará unnuevo "
"archivo. Ejecute <b>Archivo->Importar->Libro de direcciones KDE 1</b>para "
"utilizar su anterior base de datos con la nueva versión.</qt>"

#: kab_main.cc:52
msgid "new format"
msgstr "nuevo formato"

