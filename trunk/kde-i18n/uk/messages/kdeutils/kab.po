#: rc.cpp:1
msgid "Export to HTML"
msgstr "Експорт в HTML"

#: rc.cpp:2
msgid "Exporting of addresses"
msgstr "Експортую адреси"

#: rc.cpp:3
msgid "Export addresses along with entries"
msgstr "Експортувати адреси разом з записами"

#: rc.cpp:4
msgid "How should I export your addresses?"
msgstr "Як мені експортувати адреси?"

#: rc.cpp:5
msgid "Address and person in one line"
msgstr "Адреси та особи у одному рядку"

#: rc.cpp:6
msgid "All addresses"
msgstr "Всі адреси"

#: rc.cpp:7
msgid "Up to ... addresses"
msgstr "Обмежено ... адресами"

#: rc.cpp:8
msgid "Select style of HTML "
msgstr "Виберіть стиль HTML "

#: rc.cpp:9
msgid "Style of the resulting file"
msgstr "Стиль вихідного файлу"

#: rc.cpp:10
msgid "Plain HTML text without tables or lines"
msgstr "Прости текст HTML без таблиць або ліній"

#: rc.cpp:11
msgid "Expect more here..."
msgstr "Очікується ще щось..."

#: rc.cpp:12 rc.cpp:23 rc.cpp:32 rc.cpp:47
msgid "Form1"
msgstr "Бланк1"

#: rc.cpp:13
msgid "Enter the delivery label for this address here:"
msgstr ""
"Введіть позначку доставки для цієї "
"адреси:"

#: rc.cpp:14
msgid "Entry List"
msgstr "Список записів"

#: rc.cpp:15
msgid ""
"<qt>Search entries by entering"
"<br> - one of their <b>email addresses</b>"
"<br> - the <b>first name</b> or<br> - the <b>last name</b></qt>"
msgstr ""
"<qt>Пошук задається"
"<br> - одним з наступних параметрів: "
"<b>адреса ел. пошти</b> "
"<br> - <b>ім'я</b> або<br> - <b>прізвище</b></qt>"

#: rc.cpp:17
msgid "<qt>Select an entry to display it.</qt>"
msgstr "<qt>Виберіть запис для відображення.</qt>"

#: kab_htmlexport.cc:377 rc.cpp:18
msgid "Setup HTML export"
msgstr "Установка експорту HTML"

#: rc.cpp:19
msgid "Template folder:"
msgstr "Тека шаблонів:"

#: rc.cpp:20
msgid "Target folder:"
msgstr "Тека призначення:"

#: rc.cpp:21 rc.cpp:22
msgid "Choose ..."
msgstr "Вибрати ..."

#: rc.cpp:26
msgid "Hide the search results window. This will not clear your search results."
msgstr ""
"Сховати вікно результатів пошуку. Це не "
"знищить Ваші результати пошуку."

#: rc.cpp:27
msgid ""
"Hide the search results window. This will close the search results window "
"and clear all results of previous searches."
msgstr ""
"Сховати вікно результатів пошуку. Це "
"закриє вікно з результатами пошуку та "
"очистить всі результати попередніх "
"пошуків."

#: rc.cpp:29
msgid "Clear the search results and hide this window."
msgstr ""
"Очистити результати пошуку та сховати це "
"вікно."

#: rc.cpp:31
msgid "Print your search results."
msgstr "Роздрукувати результати пошуку."

#: rc.cpp:33
msgid "Search for people in your addressbook:"
msgstr "Пошук людини в адресній книзі:"

#: rc.cpp:34
msgid "Select fields to search here."
msgstr "Виберіть поля для пошуку."

#: rc.cpp:35
msgid ""
"Select fields to search here. \n"
"All entries where this field matches the pattern (consisting of wildcards or "
"regular expressions) given below will be displayed in the Search Results "
"Window."
msgstr ""
"Виберіть поля для пошуку. \n"
"Всі записи, які задовольняють наданому "
"взірцю (що укладений з джокерів або "
"регулярних виразів) будуть відображені у "
"Вікні результатів пошуку."

#: rc.cpp:36
msgid "... matches ..."
msgstr "... відповідних ..."

#: rc.cpp:37
msgid "*"
msgstr "*"

#: rc.cpp:38
msgid "Enter your expression here."
msgstr "Введіть вираз."

#: rc.cpp:39
msgid "Options:"
msgstr "Параметри:"

#: rc.cpp:40
msgid "Case sensitive search"
msgstr "З урахуванням регістру"

#: rc.cpp:41
msgid "Check this box if you want to do a case-sensitive search."
msgstr ""
"Виберіть, якщо хочете зробити пошук з "
"урахуванням регістру."

#: rc.cpp:42
msgid "Expressions"
msgstr "Вирази"

#: rc.cpp:43
msgid "Wildcards"
msgstr "Джокери"

#: rc.cpp:44
msgid ""
"Check this button if you use widlcards in your expression (as in shell "
"commands)."
msgstr ""
"Ввімкніть цей вибір, якщо Ви хочете "
"використовувати джокери у Ваших виразах "
"(як у командах оболонки)."

#: rc.cpp:45
msgid "Regular expressions"
msgstr "Регулярні вирази"

#: rc.cpp:46
msgid "Check this box if you use classical regular expressions in your pattern."
msgstr ""
"Відмітьте цю опцію, якщо Ви хочете "
"використовувати класичні регулярні "
"вирази у Ваших взірцях."

#: rc.cpp:48
msgid "Address type (e.g. Home):"
msgstr "Тип адреси (напр., Домівка):"

#: rc.cpp:49
msgid "Organization..."
msgstr "Організація..."

#: rc.cpp:50
msgid "Country:"
msgstr "Країна:"

#: rc.cpp:51
msgid "Zip code"
msgstr "Поштовий індекс"

#: rc.cpp:52
msgid "State"
msgstr "Стан"

#: rc.cpp:53
msgid "City"
msgstr "Місто"

#: rc.cpp:54
msgid "Street address:"
msgstr "Вулиця/дім/кв.:"

#: rc.cpp:55
msgid "Job title:"
msgstr "Посада:"

#: look_edit_tabaddresses.cc:328 rc.cpp:56
msgid "Delivery Label"
msgstr "Позначка доставки"

#: kab_main.cc:29 kab_main.cc:36
msgid "KDE Addressbook"
msgstr "Адресна книга KDE"

#: kab_main.cc:49
msgid ""
"<qt>Version 2 of the KDE address book is not compatible with the previous "
"one. To protect your address database, a new file will be used. Run "
"<b>File->Import->KDE 1 Addressbook</b>"
" to use your old database with the new version.</qt>"
msgstr ""
"<qt>Версія 2 адресної книги KDE є несумісною "
"з попередньою. Щоб захистити Ваші дані, "
"буде використано новий файл. Для того, щоб "
"використовувати існуючі адреси в новій "
"версії, запустіть "
"<b>Файл->Імпортувати->Адресна книга KDE "
"1</b>.</qt>"

#: kab_main.cc:54
msgid "New Format"
msgstr "Новий формат"

