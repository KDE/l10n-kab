#: index.docbook:45
#, no-c-format
msgid "&kab; (&kde; Address book) is a simple address book for &kde;."
msgstr "&kab; (&kde; Adressbuch) ist ein einfaches Adressbuch für &kde;."

#: index.docbook:49
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr "<keyword>KDE</keyword>"

#: index.docbook:50
