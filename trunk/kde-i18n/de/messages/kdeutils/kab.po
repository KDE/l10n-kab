#: kab_main.cc:29 kab_main.cc:36
msgid "KDE Addressbook"
msgstr "KDE-Adressbuch"

#: kab_main.cc:47
msgid ""
"<qt>Version 2 of the KDE address book is not compatible with the previous "
"one. To protect your address database, a new file will be used. Run "
"<b>File->Import->KDE 1 addressbook</b> to use your old database with the new "
"version.</qt>"
msgstr ""
"<qt>Version 2 des KDE-Adressbuchs ist nicht kompatibel mit den früheren.\n"
"Um Ihre Adressdatenbank zu schützen, wird eine andere Datei benutzt.\n"
"Wählen Sie \"Datei->Importieren->KDE1-Adressbuch\", um Ihre frühere\n"
"Datenbank mit der neuen Version zu benutzen.</qt>"

#: kab_main.cc:52
msgid "new format"
msgstr "Neues Format"

