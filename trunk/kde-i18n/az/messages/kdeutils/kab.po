#: kab_htmlexport.cc:444
msgid ""
"<qt>At least one <b>resource file</b> used to export your address book to "
"HTML is missing. Continue anyway?"
"<br>"
"<br><i>(Resources are used as support files like backgrounds or bullets in "
"the resulting HTML files.)</i></qt>"
msgstr ""
"<qt>"
"Ünvan dəftərini HTML olaraq qeyd etmək üçün işlədilməsi lazım "
"gələn ən az bir <b>mənbə faylı</b> tapıla bilmədi. Davam "
"edim?"
"<br>"
"<br><i>(Mənbə faylları yaradılacaq HTML səhifələrində istifadə "
"edilə biləcək arxa plan rəsmlərini ya da düyməəri daxil "
"edir.</i></qt>"

#: kab_htmlexport.cc:449
msgid ""
"<qt>At least one <b>template file</b> used to export your address book to "
"HTML is missing. Continue anyway?"
"<br>"
"<br><i>(Templates are used as a basis to create the HTML files themselves. "
"The HTML export will most probably not work without it.)</i></qt>"
msgstr ""
"<qt>"
"Ünvan dəftərini HTML olaraq qeyd etmək üçün işlədilməsi lazım "
"gələn ən az bir <b>şablon faylı</b> tapıla bilmədi. Davam "
"edim?"
"<br>"
"<br><i>(Şablonlar əsas HTML fayllarını yaratmaq üçün istifadə "
"edilir. Bunlar olmadan HTML qeydi böyük ehtimalla "
"edilməyəcəkdir.</i></qt>"

